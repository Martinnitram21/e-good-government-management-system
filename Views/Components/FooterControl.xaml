<UserControl x:Class="GoodGovernanceApp.Views.Components.FooterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
        <!-- Status Footer — Column 1, Row 2 -->
        <Border Background="LightYellow" Padding="16,8">
            <Grid>
                <!-- Left: System Ready -->
                <Button HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#8DB355" Padding="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="SYSTEM READY" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <!-- Center-right / Right: Status and Time -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="CLOUD SYNC:" Foreground="White" FontSize="12" Margin="0,0,4,0"/>
                    <TextBlock Text="ONLINE" Foreground="#8DB355" FontSize="12" FontWeight="Bold" Margin="0,0,8,0" Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="OFFLINE" Foreground="#D90000" FontSize="12" FontWeight="Bold" Margin="0,0,8,0" Visibility="{Binding IsOnline, Converter={StaticResource InvBoolToVis}}"/>
                    <TextBlock Text="{Binding SyncStatus}" FontSize="12" Margin="0,0,4,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#8DB355"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSyncErrors}" Value="True">
                                        <Setter Property="Foreground" Value="#D90000"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Sync Error Count Badge -->
                    <Border CornerRadius="8" Background="#D90000" MinWidth="18" Height="18"
                            Padding="4,0" Margin="0,0,8,0" VerticalAlignment="Center"
                            Visibility="{Binding HasSyncErrors, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SyncErrorCount}" Foreground="White"
                                   FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- View Log Button -->
                    <Button Command="{Binding ViewSyncLogCommand}"
                            Background="Transparent" BorderThickness="0" Padding="4,4" Margin="0,0,8,0"
                            Foreground="#666" Cursor="Hand" ToolTip="Open sync log file">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="14" Height="14" Margin="0,0,3,0"/>
                            <TextBlock Text="LOG" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SyncNowCommand}"
                            Background="white" BorderThickness="0" Padding="8,4" Margin="0,0,24,0"
                            Foreground="black" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CloudSync" Width="14" Height="14" Margin="0,0,4,0"/>
                            <TextBlock Text="SYNC NOW" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateTileCommand}" CommandParameter="Profile"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,24,0"
                            Foreground="black" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AccountEdit" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="MY PROFILE" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <materialDesign:PackIcon Kind="ClockOutline" Foreground="black" Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding CurrentDate}" Foreground="black" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
</UserControl>
