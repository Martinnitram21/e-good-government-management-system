<UserControl x:Class="GoodGovernanceApp.Views.Components.FooterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
        <!-- Status Footer — Column 1, Row 2 -->
        <Border Background="LightYellow" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: System Ready -->
                <Button Grid.Column="0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#8DB355" Padding="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="SYSTEM READY" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <!-- Center: ONLY the database currently in use (single status) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Database" Width="15" Height="15" Foreground="#333" Margin="0,0,5,0"/>
                    <TextBlock Text="ACTIVE DB:" Foreground="#333" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ActiveDatabaseMode}" Foreground="#000" FontSize="11" FontWeight="Bold" Margin="4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ActiveDatabaseStatusText}" FontSize="11" FontWeight="Bold" Margin="0,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#B8860B"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveConnectionIsOnline}" Value="True">
                                        <Setter Property="Foreground" Value="#5C8F28"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ConnectionCheckCompleted}" Value="True"/>
                                            <Condition Binding="{Binding ActiveConnectionIsOnline}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="#D90000"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Right: diagnostics, actions, profile, and time -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                    <!-- Sync Error Count Badge -->
                    <Border CornerRadius="8" Background="#D90000" MinWidth="18" Height="18"
                            Padding="4,0" Margin="0,0,8,0" VerticalAlignment="Center"
                            Visibility="{Binding HasSyncErrors, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SyncErrorCount}" Foreground="White"
                                   FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- View Log Button -->
                    <Button Command="{Binding ViewSyncLogCommand}"
                            Background="Transparent" BorderThickness="0" Padding="4,4" Margin="0,0,8,0"
                            Foreground="#666" Cursor="Hand" ToolTip="Open sync log file">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="14" Height="14" Margin="0,0,3,0"/>
                            <TextBlock Text="LOG" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SyncNowCommand}"
                            Background="white" BorderThickness="0" Padding="8,4" Margin="0,0,24,0"
                            Foreground="black" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CloudSync" Width="14" Height="14" Margin="0,0,4,0"/>
                            <TextBlock Text="SYNC NOW" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateTileCommand}" CommandParameter="Profile"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,24,0"
                            Foreground="black" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AccountEdit" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="MY PROFILE" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <materialDesign:PackIcon Kind="ClockOutline" Foreground="black" Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding CurrentDate}" Foreground="black" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
</UserControl>
