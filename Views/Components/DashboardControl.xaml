<UserControl x:Class="GoodGovernanceApp.Views.Components.DashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <Style x:Key="DashboardModuleButton" TargetType="Button"
               BasedOn="{StaticResource TileButtonStyle}">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowDuration" Value="5000"/>
        </Style>

        <ItemsPanelTemplate x:Key="SingleDashboardRow">
            <UniformGrid Rows="1"/>
        </ItemsPanelTemplate>

        <DataTemplate x:Key="DashboardModuleTemplate">
            <Button Style="{StaticResource DashboardModuleButton}"
                    Command="{Binding DataContext.NavigateTileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding ViewToken}"
                    Background="{Binding TileColor, Converter={StaticResource ColorConverter}}"
                    ToolTip="{Binding Description}">
                <Grid MinHeight="140">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Width="54" Height="54" CornerRadius="14"
                            Background="#29FFFFFF"
                            HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="{Binding Icon}"
                                                 Width="31" Height="31"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Description}"
                                   Foreground="White"
                                   FontSize="11"
                                   Opacity="0.82"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="12">
        <!-- Dashboard view: system-themed Metro mosaic. -->
        <Grid Visibility="{Binding IsShowingDashboard, Converter={StaticResource BoolToVis}}">
            <Border Background="LightYellow"
                    BorderBrush="#E5DFA8"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10">
                <Grid MaxWidth="1700">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                        <!-- Asymmetric module mosaic. -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <ItemsControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                                          ItemsSource="{Binding DashboardPrimaryItems}"
                                          ItemTemplate="{StaticResource DashboardModuleTemplate}"
                                          ItemsPanel="{StaticResource SingleDashboardRow}"/>

                            <!-- Wide organization/identity tile. -->
                            <Border Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2"
                                    Margin="4" CornerRadius="8" ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#171717" Offset="0"/>
                                        <GradientStop Color="#3A0808" Offset="0.62"/>
                                        <GradientStop Color="#D90000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid Margin="22,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="94" Height="94" CornerRadius="12"
                                            Background="Transparent" Padding="8"
                                            VerticalAlignment="Center">
                                        <Image Source="pack://application:,,,/GoodGovernanceApp;component/Assets/Images/sulopgovsolo.png"
                                               Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GovernanceName}"
                                                   Foreground="White"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="GOOD GOVERNANCE MANAGEMENT SYSTEM"
                                                   Foreground="#F3D95E"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Margin="0,7,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Large live date/time area, mirroring the reference. -->
                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                    Background="#171717" CornerRadius="8" Margin="4" Padding="24,18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="38" Height="38" CornerRadius="10" Background="#D90000">
                                            <materialDesign:PackIcon Kind="CalendarClock"
                                                                     Width="21" Height="21"
                                                                     Foreground="White"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="LIVE SYSTEM TIME"
                                                   Foreground="#F3D95E"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Margin="11,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding CurrentDate}"
                                               Foreground="White"
                                               FontSize="27"
                                               FontWeight="Light"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <ItemsControl Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3"
                                          ItemsSource="{Binding DashboardMiddleItems}"
                                          ItemTemplate="{StaticResource DashboardModuleTemplate}"
                                          ItemsPanel="{StaticResource SingleDashboardRow}"/>

                            <!-- Active database state. -->
                            <Border Grid.Row="1" Grid.Column="5" Margin="4" CornerRadius="8" Padding="17">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#B38B00"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveConnectionIsOnline}" Value="False">
                                                <Setter Property="Background" Value="#D90000"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <materialDesign:PackIcon Kind="DatabaseCheckOutline"
                                                             Width="42" Height="42"
                                                             Foreground="White"/>
                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="DATABASE" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ActiveDatabaseStatusText}"
                                                   Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,3,0,0"/>
                                        <TextBlock Foreground="White" FontSize="10" Opacity="0.86" Margin="0,4,0,0">
                                            <Run Text="{Binding ActiveDatabaseMode, Mode=OneWay}"/><Run Text=" connection"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Seven equal final-row slots keep every module visible after
                                 Analytics was added. The final three are Settings, Profile,
                                 and Logout, in that order. -->
                            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ItemsControl Grid.Column="0" Grid.ColumnSpan="6"
                                              ItemsSource="{Binding DashboardBottomItems}"
                                              ItemTemplate="{StaticResource DashboardModuleTemplate}"
                                              ItemsPanel="{StaticResource SingleDashboardRow}"/>

                                <Button Grid.Column="6"
                                        Style="{StaticResource DashboardModuleButton}"
                                        Command="{Binding LogoutCommand}"
                                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                        Background="#D90000"
                                        ToolTip="End your session and return to login">
                                    <Grid MinHeight="140">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Width="54" Height="54" CornerRadius="14"
                                                Background="#29FFFFFF" HorizontalAlignment="Left">
                                            <materialDesign:PackIcon Kind="Logout"
                                                                     Width="31" Height="31"
                                                                     Foreground="White"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Row="2">
                                            <TextBlock Text="Logout" Foreground="White" FontSize="17" FontWeight="Bold"/>
                                            <TextBlock Text="End your session." Foreground="White" FontSize="11" Opacity="0.82" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Grid>
                        </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Active module view. -->
        <Grid Visibility="{Binding IsShowingView, Converter={StaticResource BoolToVis}}">
            <Border Background="#FFFFFF" CornerRadius="12" Padding="8">
                <ContentControl Content="{Binding CurrentView}" Margin="0,2,0,0">
                    <ContentControl.Template>
                        <ControlTemplate TargetType="ContentControl">
                            <Border x:Name="Bd" Opacity="0">
                                <ContentPresenter/>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
                                                <ThicknessAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Margin" From="0,22,0,0" To="0,0,0,0" Duration="0:0:0.28"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </ControlTemplate>
                    </ContentControl.Template>
                </ContentControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
