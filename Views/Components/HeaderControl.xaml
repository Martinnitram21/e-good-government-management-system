<UserControl x:Class="GoodGovernanceApp.Views.Components.HeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <Style x:Key="HeaderModalActionStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Foreground" Value="#171717"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E5DFA8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#FFF9C9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#F3EFAE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
        <!-- Top Header Bar — Column 1, Row 0 (also the window drag handle) -->
        <Border Background="LightYellow" BorderBrush="LightYellow" BorderThickness="0,0,0,1" Padding="24,16"
                MouseLeftButtonDown="HeaderDragMove">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left: Hamburger + eSulopGov brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleSidebarCommand}"
                            Visibility="{Binding IsShowingView, Converter={StaticResource BoolToVis}}"
                            Background="Transparent" BorderThickness="0"
                            Foreground="Black"
                            Margin="0,0,16,0"
                            Padding="0"
                            Width="40" Height="40">
                        <materialDesign:PackIcon Kind="Menu" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Rectangle Width="330" Height="76"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="pack://application:,,,/GoodGovernanceApp;component/Assets/Images/sulopgov.png"
                                        Viewbox="0.025,0.385,0.95,0.255"
                                        ViewboxUnits="RelativeToBoundingBox"
                                        Stretch="Uniform"
                                        AlignmentX="Left"
                                        AlignmentY="Center"/>
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>

                <!-- Contextual modal shortcuts: hidden on the dashboard. -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="16,0"
                            Visibility="{Binding IsShowingView, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource HeaderModalActionStyle}"
                            Command="{Binding NavigateTileCommand}"
                            CommandParameter="ConsolidatedTransactions"
                            ToolTip="Search consolidated transactions">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TableMultiple" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Consolidated" Margin="7,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource HeaderModalActionStyle}"
                            Command="{Binding NavigateTileCommand}"
                            CommandParameter="BudgetAllocation"
                            ToolTip="Select a budget year">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ScaleBalance" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Budget Allocation" Margin="7,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource HeaderModalActionStyle}"
                            Command="{Binding OpenSystemsProfileCommand}"
                            ToolTip="Open system profile">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DatabaseSettings" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="System Profile" Margin="7,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: Notifications + Username + Role + Avatar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    
                    <!-- Notification Bell -->
                    <Button Command="{Binding OpenNotificationsCommand}"
                            Width="40" Height="40"
                            Margin="0,0,24,0"
                            Cursor="Hand"
                            BorderThickness="0"
                            Background="Transparent"
                            ToolTip="Notifications">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="20"
                                        Background="Transparent"
                                        Width="40" Height="40">
                                    <Grid>
                                        <!-- Bell icon -->
                                        <materialDesign:PackIcon Kind="BellOutline"
                                                                 Foreground="Black"
                                                                 Width="22" Height="22"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                        <!-- Red dot badge -->
                                        <Border Background="#D90000"
                                                Width="10" Height="10"
                                                CornerRadius="5"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,5,5,0"
                                                Visibility="{Binding HasNewNotifications,
                                                    Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <!-- Notification Popup -->
                    <!-- Removed popup as it is now a DialogHost at the root -->

                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding CurrentUserName}" Foreground="Black" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding CurrentUserRole}" Foreground="#000000" FontSize="12" HorizontalAlignment="Right"/>
                    </StackPanel>
                    
                    <Button Width="48" Height="48" BorderThickness="0" Background="Transparent" Padding="0"
                            Command="{Binding NavigateTileCommand}" CommandParameter="Profile"
                            ToolTip="My Profile">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                    <!-- Municipal seal is the default user image. -->
                                    <Image Source="pack://application:,,,/GoodGovernanceApp;component/Assets/Images/login.png"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <!-- A user-uploaded profile photo replaces the default seal. -->
                                    <Image Source="{Binding ProfilePhotoSource}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Custom window controls (themed) -->
                    <Button Width="34" Height="34" BorderThickness="0" Padding="0" Margin="16,0,0,0"
                            Command="{Binding MinimizeMainWindowCommand}" ToolTip="Minimize">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Width="34" Height="34">
                                    <materialDesign:PackIcon Kind="WindowMinimize" Foreground="Black" Width="16" Height="16"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E5DFA8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Width="34" Height="34" BorderThickness="0" Padding="0" Margin="4,0,0,0"
                            Command="{Binding CloseMainWindowCommand}" ToolTip="Close">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Width="34" Height="34">
                                    <materialDesign:PackIcon x:Name="Icon" Kind="Close" Foreground="Black" Width="16" Height="16"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#D90000"/>
                                        <Setter TargetName="Icon" Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>
</UserControl>
