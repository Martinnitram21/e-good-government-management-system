<UserControl x:Class="GoodGovernanceApp.Views.Components.HeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
        <!-- Top Header Bar — Column 1, Row 0 -->
        <Border Background="LightYellow" BorderBrush="LightYellow" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left: Hamburger + Org name + Subtitle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleSidebarCommand}"
                            Background="Transparent" BorderThickness="0"
                            Foreground="Black"
                            Margin="0,0,16,0"
                            Padding="0"
                            Width="40" Height="40">
                        <materialDesign:PackIcon Kind="Menu" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding GovernanceName}" FontSize="20" FontWeight="Bold" Foreground="Black"/>
                        <TextBlock Text="Governance Management System" FontSize="13" Foreground="Black" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Notifications + Username + Role + Avatar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    
                    <!-- Notification Bell -->
                    <Button Command="{Binding OpenNotificationsCommand}"
                            Width="40" Height="40"
                            Margin="0,0,24,0"
                            Cursor="Hand"
                            BorderThickness="0"
                            Background="Transparent"
                            ToolTip="Notifications">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="20"
                                        Background="Transparent"
                                        Width="40" Height="40">
                                    <Grid>
                                        <!-- Bell icon -->
                                        <materialDesign:PackIcon Kind="BellOutline"
                                                                 Foreground="Black"
                                                                 Width="22" Height="22"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                        <!-- Red dot badge -->
                                        <Border Background="#D90000"
                                                Width="10" Height="10"
                                                CornerRadius="5"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,5,5,0"
                                                Visibility="{Binding HasNewNotifications,
                                                    Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <!-- Notification Popup -->
                    <!-- Removed popup as it is now a DialogHost at the root -->

                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding CurrentUserName}" Foreground="Black" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding CurrentUserRole}" Foreground="#000000" FontSize="12" HorizontalAlignment="Right"/>
                    </StackPanel>
                    
                    <Button Width="40" Height="40" BorderThickness="0" Background="Transparent" Padding="0" Command="{Binding NavigateTileCommand}" CommandParameter="Profile">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#D90000" CornerRadius="20" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding ProfilePhotoSource}" Stretch="UniformToFill"/>
                                        <materialDesign:PackIcon Kind="Account" Foreground="Black" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ProfilePhotoSource, Converter={StaticResource InvBoolToVis}}"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
</UserControl>
