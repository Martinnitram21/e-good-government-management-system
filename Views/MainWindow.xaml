<Window x:Class="GoodGovernanceApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:GoodGovernanceApp.ViewModels"
        xmlns:converters="clr-namespace:GoodGovernanceApp.Converters"
        xmlns:components="clr-namespace:GoodGovernanceApp.Views.Components"
        Title="Good Governance Management System"
        Icon="pack://application:,,,/GoodGovernanceApp;component/Assets/Images/ggms.ico"
        Height="780" Width="1280"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F3F5F7"
        FontFamily="Segoe UI"
        Name="MainWin">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GoodGovernanceApp;component/Views/Styles/MetroTileStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:StringToSolidColorBrushConverter  x:Key="ColorConverter"/>
            <converters:BoolToVisibilityConverter          x:Key="BoolToVis"/>
            <converters:InverseBoolToVisibilityConverter   x:Key="InvBoolToVis"/>
            <converters:NullToVisibilityConverter          x:Key="NullToVis"/>

            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#8DB355"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Height" Value="56"/>
                <Setter Property="Margin" Value="16,4,16,4"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="8,0">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#000000"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#000000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TileButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin" Value="8"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="16">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0:0:0.05"/>
                                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0:0:0.05"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.05"/>
                                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.05"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <materialDesign:DialogHost IsOpen="{Binding IsNotificationPopupOpen}" Identifier="RootDialog" DialogTheme="Light"
                               CloseOnClickAway="True">
        <materialDesign:DialogHost.DialogContent>
            <Border Width="520" MaxHeight="640" CornerRadius="20"
                    Background="#FFFFFF"
                    Effect="{DynamicResource MaterialDesignShadowDepth5}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="20,20,0,0" Padding="24,20,20,20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#000000" Offset="0"/>
                                <GradientStop Color="#000000" Offset="0.6"/>
                                <GradientStop Color="#D90000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23"
                                    Margin="0,0,14,0" VerticalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="#D90000" Opacity="0.35"/>
                                </Border.Background>
                                <materialDesign:PackIcon Kind="BellRing" Foreground="white"
                                                         Width="24" Height="24"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Notifications" FontSize="20" FontWeight="Bold"
                                           Foreground="Black"/>
                                <TextBlock Text="Recent system activity" FontSize="12"
                                           Foreground="Black" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                                    Width="34" Height="34" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="17" Background="white">
                                    <materialDesign:PackIcon Kind="Close" Foreground="Black"
                                                             Width="16" Height="16"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Padding="16,12,16,4">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Notifications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" CornerRadius="12"
                                                Background="#FFFFFF"
                                                BorderThickness="0">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="8"
                                                                  ShadowDepth="2" Opacity="0.1"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" CornerRadius="12,0,0,12"
                                                        Background="{Binding Color, Converter={StaticResource ColorConverter}}"/>

                                                <Grid Grid.Column="1" Margin="14,14,14,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="44" Height="44"
                                                            CornerRadius="22" Margin="0,0,12,0"
                                                            VerticalAlignment="Top">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="#F3F5F7"/>
                                                        </Border.Background>
                                                        <materialDesign:PackIcon
                                                            Kind="{Binding Icon}"
                                                            Foreground="{Binding Color, Converter={StaticResource ColorConverter}}"
                                                            Width="22" Height="22"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontWeight="SemiBold" FontSize="14"
                                                                   Foreground="#000000"/>
                                                        <TextBlock Text="{Binding Message}"
                                                                   FontSize="12" Foreground="#8DB355"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,3,0,5"
                                                                   MaxWidth="230"/>
                                                        <Border Background="#F3F5F7" CornerRadius="4"
                                                                Padding="6,2" HorizontalAlignment="Left">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="ClockOutline"
                                                                    Width="11" Height="11"
                                                                    Foreground="#8DB355"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,4,0"/>
                                                                <TextBlock Text="{Binding FormattedDate}"
                                                                           FontSize="11" Foreground="#8DB355"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>

                                                    <Button Grid.Column="2"
                                                            Command="{Binding DataContext.NotificationClickedCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding ViewToken}"
                                                            VerticalAlignment="Center"
                                                            Padding="12,6"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Margin="8,0,0,0">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" CornerRadius="20"
                                                                        Padding="12,6"
                                                                        Background="{Binding Color, Converter={StaticResource ColorConverter}}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="View"
                                                                                   FontSize="12"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="Black"/>
                                                                        <materialDesign:PackIcon Kind="ArrowRight"
                                                                            Width="13" Height="13"
                                                                            Foreground="Black"
                                                                            VerticalAlignment="Center"
                                                                            Margin="4,0,0,0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel HorizontalAlignment="Center" Margin="0,32,0,32"
                                        Visibility="{Binding HasNewNotifications, Converter={StaticResource InvBoolToVis}}">
                                <Border Width="80" Height="80" CornerRadius="40"
                                        Background="#F3F5F7" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="BellOffOutline"
                                                             Width="36" Height="36"
                                                             Foreground="Black"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="All caught up!" FontSize="16" FontWeight="SemiBold"
                                           Foreground="#000000" HorizontalAlignment="Center"
                                           Margin="0,16,0,4"/>
                                <TextBlock Text="No recent system activity to show."
                                           FontSize="13" Foreground="#8DB355"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" CornerRadius="0,0,20,20"
                            Background="#FFFFFF" Padding="20,12"
                            BorderThickness="0,1,0,0" BorderBrush="#F3F5F7">
                        <Grid>
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#8DB355">
                                <Run Text="Showing latest"/>
                                <Run Text="{Binding Notifications.Count, Mode=OneWay}" FontWeight="SemiBold" Foreground="#D90000"/>
                                <Run Text="notifications"/>
                            </TextBlock>
                            <Button HorizontalAlignment="Right"
                                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                                    Padding="16,6" BorderThickness="1" BorderBrush="#E0E0E0"
                                    Background="#F3F5F7" Foreground="#8DB355"
                                    FontSize="13" FontWeight="SemiBold"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="8" Padding="16,7"
                                                Background="#F3F5F7" BorderThickness="1"
                                                BorderBrush="#E0E0E0">
                                            <TextBlock Text="Dismiss All" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#8DB355"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </materialDesign:DialogHost.DialogContent>


        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarOpen}" Value="True">
                                    <Setter Property="Width" Value="264"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <components:SidebarControl Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" />
            <components:HeaderControl Grid.Column="1" Grid.Row="0" />
            <components:DashboardControl Grid.Column="1" Grid.Row="1" />
            <components:FooterControl Grid.Column="1" Grid.Row="2" />

        </Grid>
    </materialDesign:DialogHost>
</Window>