<Window x:Class="GoodGovernanceApp.Views.DatabaseSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:GoodGovernanceApp.ViewModels"
        Title="Database Connection Settings" Height="486" Width="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">


    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0 0 0 16">
            <TextBlock Text="Database Configuration" FontSize="24" FontWeight="Light" Foreground="#000000"/>
            <TextBlock Text="Select a preset or manually enter your connection details." 
                       FontSize="12" Foreground="#000000" Margin="0 4 0 0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- GGMS Remote Connection -->
                <materialDesign:Card Margin="0 0 0 16" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                            <materialDesign:PackIcon Kind="CloudSync" Width="22" Height="22" 
                                                     VerticalAlignment="Center" Margin="0 0 8 0"
                                                     Foreground="#000000"/>
                            <TextBlock Text="Cloud Sync Database (Hostinger)" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#000000"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Hostinger Server / IP"
                                     Text="{Binding RemoteServer, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Foreground="#000000"
                                     Margin="0 0 0 12"/>
                            <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Port"
                                     Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Foreground="#000000"
                                     Margin="0 0 0 12"/>
                        </Grid>

                        <TextBox materialDesign:HintAssist.Hint="Database Name"
                                 Text="{Binding RemoteDatabase, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 Foreground="#000000"
                                 Margin="0 0 0 12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Database Username"
                                     Text="{Binding RemoteUser, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Foreground="#000000"/>
                            <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Database Password"
                                     Text="{Binding RemotePassword, UpdateSourceTrigger=PropertyChanged}"
                                     Foreground="#000000"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- CRS Connection -->
                <materialDesign:Card Margin="0 0 0 16" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                            <materialDesign:PackIcon Kind="DatabaseSearch" Width="22" Height="22" 
                                                     VerticalAlignment="Center" Margin="0 0 8 0"
                                                     Foreground="#D90000"/>
                            <TextBlock Text="CRS Database Connection (Read Only)" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#000000"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="CRS Server / IP"
                                     Text="{Binding CrsServer, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Foreground="#000000"
                                     Margin="0 0 0 12"/>
                            <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Port"
                                     Text="{Binding CrsPort, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Foreground="#000000"
                                     Margin="0 0 0 12"/>
                        </Grid>

                        <TextBox materialDesign:HintAssist.Hint="CRS Database Name"
                                 Text="{Binding CrsDatabase, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 Foreground="#000000"
                                 Margin="0 0 0 12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="CRS Username"
                                     Text="{Binding CrsUser, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Foreground="#000000"/>
                            <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="CRS Password"
                                     Text="{Binding CrsPassword, UpdateSourceTrigger=PropertyChanged}"
                                     Foreground="#000000"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>
               

                <!-- Test Connection -->
                <materialDesign:Card Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                            <materialDesign:PackIcon Kind="CheckNetwork" Width="20" Height="20" 
                                                     VerticalAlignment="Center" Margin="0 0 8 0"
                                                     Foreground="#000000"/>
                            <TextBlock Text="Test Connections" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"  Foreground="#000000"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                            <Button x:Name="TestConnectionBtn" Content="🔌 TEST BOTH"
                                    Command="{Binding TestBothCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="0 0 12 0"/>
                            <ProgressBar x:Name="TestProgress" IsIndeterminate="True"
                                         Width="24" Height="24"
                                         Style="{StaticResource MaterialDesignCircularProgressBar}"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding IsTesting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding SqliteTestResult}" FontSize="13" FontWeight="Medium" Margin="0 0 0 4"
                                   Foreground="#000000"/>
                        <TextBlock Text="{Binding GgmsTestResult}" FontSize="13" FontWeight="Medium" Margin="0 0 0 4"
                                   Foreground="#000000"/>
                        <TextBlock Text="{Binding CrsTestResult}" FontSize="13" FontWeight="Medium"
                                   Foreground="#000000"/>
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 16 0 0">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="0 0 16 0" Foreground="Green"/>
            <Button Content="SAVE &amp; CLOSE" Command="{Binding SaveSettingsCommand}" Click="SaveButton_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>
