<UserControl x:Class="GoodGovernanceApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:GoodGovernanceApp.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="850">



    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0 0 0 24">
                <TextBlock Text="System Settings" FontSize="28" FontWeight="Light"  Foreground="#000000"/>
                <TextBlock Text="Configure database connections, backups, and app profile" 
                           FontSize="13" Foreground="#000000" Margin="0 4 0 0"/>
            </StackPanel>

            <!-- System Application Profile section removed - image now automatically loaded from Assets/Images -->

            <!-- Proof of Copyright section removed - image now automatically loaded from Assets/Images -->

            <!-- Department Management -->
            <materialDesign:Card Grid.Row="1" Margin="0 0 0 16" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                        <materialDesign:PackIcon Kind="OfficeBuilding" Width="22" Height="22" 
                                                 VerticalAlignment="Center" Margin="0 0 8 0"
                                                 Foreground="#000000"/>
                        <TextBlock Text="Department Management" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#000000"/>
                    </StackPanel>

                    <TextBlock Text="Add, edit, and remove departments. Manage office codes and view associated projects." 
                               FontSize="13" Foreground="#000000" Margin="0 0 0 16"/>

                    <Button Content="🏢 CONFIGURE DEPARTMENTS" 
                            Command="{Binding OpenDepartmentsCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            HorizontalAlignment="Left" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Local Database (SQLite) -->
            <materialDesign:Card Grid.Row="2" Margin="0 0 0 16" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                        <materialDesign:PackIcon Kind="Database" Width="22" Height="22" 
                                                 VerticalAlignment="Center" Margin="0 0 8 0"
                                                 Foreground="#000000"/>
                        <TextBlock Text="Local Database (SQLite)" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#000000"/>
                    </StackPanel>

                    <TextBlock Text="Primary offline-first database used for all local operations." 
                               FontSize="13" Foreground="#000000" Margin="0 0 0 12"/>

                    <TextBox materialDesign:HintAssist.Hint="Database File Path"
                             Text="{Binding SqliteDbPath, Mode=OneWay}"
                             IsReadOnly="True"
                             Foreground="#000000"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             Margin="0 0 0 12"/>

                    <TextBlock Text="{Binding SqliteStatus}" FontSize="12" Foreground="#555555" Margin="0 0 0 16"/>

                    <Button Content="📂 OPEN DATABASE FOLDER" 
                            Command="{Binding OpenSqliteFolderCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            HorizontalAlignment="Left" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Cloud Synchronization (MySQL) -->
            <materialDesign:Card Grid.Row="3" Margin="0 0 0 16" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                        <materialDesign:PackIcon Kind="CloudSync" Width="22" Height="22" 
                                                 VerticalAlignment="Center" Margin="0 0 8 0"
                                                 Foreground="#000000"/>
                        <TextBlock Text="Cloud Sync Server (Hostinger MySQL)" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#000000"/>
                    </StackPanel>

                    <TextBlock Text="Remote Hostinger database used for multi-office synchronization." 
                               FontSize="12" Foreground="#000000" Margin="0 0 0 16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Hostinger Server / IP"
                                 Text="{Binding RemoteServer, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 Foreground="#000000"
                                 Margin="0 0 0 12"/>
                        <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Port"
                                 Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 Foreground="#000000"
                                 Margin="0 0 0 12"/>
                    </Grid>

                    <TextBox materialDesign:HintAssist.Hint="Database Name"
                             Text="{Binding RemoteDatabase, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             Foreground="#000000"
                             Margin="0 0 0 12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Database Username"
                                 Text="{Binding RemoteUser, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 Foreground="#000000"/>
                        <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Database Password"
                                 Text="{Binding RemotePassword, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#000000"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- CRS Database Connection -->
            <materialDesign:Card Grid.Row="4" Margin="0 0 0 16" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                        <materialDesign:PackIcon Kind="DatabaseSearch" Width="22" Height="22" 
                                                 VerticalAlignment="Center" Margin="0 0 8 0"
                                                 Foreground="#D90000"/>
                        <TextBlock Foreground="#000000" Text="CRS Database Connection (Read Only)" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="⚠ CRS is read-only for GGMS. Used for constituent lookup." 
                               FontSize="12" FontStyle="Italic"
                               Foreground="#000000" Margin="0 0 0 16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="CRS Server / IP"
                                 Text="{Binding CrsServer, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 Foreground="#000000"
                                 Margin="0 0 0 12"/>
                        <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Port"
                                 Text="{Binding CrsPort, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 Foreground="#000000"
                                 Margin="0 0 0 12"/>
                    </Grid>

                    <TextBox materialDesign:HintAssist.Hint="CRS Database Name"
                             Text="{Binding CrsDatabase, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             Foreground="#000000"
                             Margin="0 0 0 12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="CRS Username"
                                 Text="{Binding CrsUser, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 Foreground="#000000"/>
                        <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="CRS Password"
                                 Text="{Binding CrsPassword, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#000000"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Test + Save -->
            <materialDesign:Card Grid.Row="5" Margin="0 0 0 16" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                        <materialDesign:PackIcon Kind="CheckNetwork" Width="22" Height="22" 
                                                 VerticalAlignment="Center" Margin="0 0 8 0"
                                                 Foreground="#000000"/>
                        <TextBlock Text="Test &amp; Save" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#000000"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                        <Button Content="🔌 TEST ALL CONNECTIONS" Command="{Binding TestBothCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}" Margin="0 0 12 0"/>
                        <ProgressBar IsIndeterminate="True" Width="24" Height="24"
                                     Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding IsTesting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding SqliteTestResult}" FontSize="13" FontWeight="Medium" Margin="0 0 0 4"
                               Foreground="#000000"/>
                    <TextBlock Text="{Binding GgmsTestResult}" FontSize="13" FontWeight="Medium" Margin="0 0 0 4"
                               Foreground="#000000"/>
                    <TextBlock Text="{Binding CrsTestResult}" FontSize="13" FontWeight="Medium" Margin="0 0 0 16"
                               Foreground="#000000"/>

                    <Button Content="💾 SAVE SETTINGS (REQUIRES RESTART)"
                            Command="{Binding SaveSettingsCommand}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource MaterialDesignRaisedButton}"/>

                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="Medium"
                               Foreground="#8DB355" Margin="0 12 0 0"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- Backup Configuration                                           -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <materialDesign:Card Grid.Row="6" Margin="0 0 0 16" Padding="24">
            <StackPanel>

                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                    <materialDesign:PackIcon Kind="DatabaseSync" Width="22" Height="22"
                                            VerticalAlignment="Center" Margin="0 0 8 0"
                                             Foreground="#000000"/>
                    <TextBlock Text="Automatic Database Backup" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="#000000"/>
                </StackPanel>

                <!-- ── Row 1 : Backup Type + Schedule Type ─────────────── -->
                <Grid Margin="0 0 0 16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Backup Type" FontSize="12"
                                   Foreground="#000000" Margin="0 0 0 4"/>
                        <ComboBox SelectedItem="{Binding BackupType}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
                            <ComboBoxItem Content="Full"/>
                            <ComboBoxItem Content="Differential"/>
                            <ComboBoxItem Content="Incremental"/>
                        </ComboBox>
                        <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0 4 0 0"
                                   Foreground="#000000">
                            <Run FontWeight="Bold">Full</Run><Run> — schema + all data (baseline).</Run>
                            <LineBreak/>
                            <Run FontWeight="Bold">Differential</Run><Run> — data-only dump (since last full).</Run>
                            <LineBreak/>
                            <Run FontWeight="Bold">Incremental</Run><Run> — data delta since last backup.</Run>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Schedule Type" FontSize="12"
                                   Foreground="#000000" Margin="0 0 0 4"/>
                        <ComboBox SelectedItem="{Binding ScheduleType}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
                            <ComboBoxItem Content="Once"/>
                            <ComboBoxItem Content="Daily"/>
                            <ComboBoxItem Content="Weekly"/>
                            <ComboBoxItem Content="Monthly"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- ── Row 2 : Date (Once) or Day-of-Month (Monthly) ───── -->
                <Grid Margin="0 0 0 16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- DatePicker: shown for "Once" -->
                    <StackPanel Grid.Column="0"
                                Visibility="{Binding IsOnce, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Run Date &amp; Time" FontSize="12"
                                   Foreground="#000000" Margin="0 0 0 4"/>
                        <DatePicker SelectedDate="{Binding NextRunTime}"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                    </StackPanel>

                    <!-- Day of month: shown for "Monthly" -->
                    <StackPanel Grid.Column="0"
                                Visibility="{Binding IsMonthlyOrOnce, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!-- only show when Monthly (not Once) -->
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScheduleType}" Value="Monthly">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        </StackPanel>

                    <!-- Start time (Next run): always visible -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="First / Next Run Date-Time" FontSize="12"
                                   Foreground="#000000" Margin="0 0 0 4"/>
                        <DatePicker SelectedDate="{Binding NextRunTime}"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                        <TextBlock Text="(Time-of-day is preserved from the saved value)"
                                   FontSize="10" TextWrapping="Wrap" Margin="0 3 0 0"
                                   Foreground="#000000"/>
                    </StackPanel>
                </Grid>

                <!-- ── Row 3 : Backup Folder ──────────────────────────── -->
                <TextBlock Text="Backup Destination Folder" FontSize="12"
                           Foreground="#000000" Margin="0 0 0 4"/>
                <Grid Margin="0 0 0 16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             materialDesign:HintAssist.Hint="e.g. C:\Backups\GGMS"
                             Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                              Foreground="#000000"/>
                    <Button Grid.Column="2" Content="📁 Browse"
                            Command="{Binding BrowseBackupFolderCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                </Grid>

                <!-- ── Row 4 : mysqldump path ──────────────────────────── -->
                <TextBlock Text="mysqldump.exe Path" FontSize="12"
                           Foreground="#000000" Margin="0 0 0 4"/>
                <Grid Margin="0 0 0 16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             materialDesign:HintAssist.Hint="e.g. C:\Program Files\MySQL\...\mysqldump.exe"
                             Text="{Binding MySqlDumpPath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                              Foreground="#000000"/>
                    <Button Grid.Column="2" Content="🔍 Browse"
                            Command="{Binding BrowseMySqlDumpCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                </Grid>

                <!-- ── Row 5 : Enable toggle + Save ───────────────────── -->
                <StackPanel Orientation="Horizontal" Margin="0 0 0 20">
                    <ToggleButton IsChecked="{Binding IsBackupEnabled}"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  VerticalAlignment="Center"/>
                    <TextBlock Text="Enable Automatic Backup" FontSize="14"
                               VerticalAlignment="Center" Margin="12 0 0 0"  Foreground="#000000"/>
                </StackPanel>

                <Button Content="💾 SAVE BACKUP SETTINGS"
                        Command="{Binding SaveBackupSettingsCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        HorizontalAlignment="Left" Margin="0 0 0 20"/>

                <!-- Status / Next run -->
                <TextBlock Text="{Binding BackupStatusMessage}" FontSize="13" FontWeight="Medium"
                           Foreground="#8DB355" Margin="0 0 0 20" TextWrapping="Wrap"/>

                <!-- ── Row 6 : Manual trigger buttons ─────────────────── -->
                <Separator Margin="0 0 0 16"/>
                <TextBlock Text="Manual Backup — run now" FontSize="13" FontWeight="SemiBold"
                           Margin="0 0 0 12"
                           Foreground="#000000"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="⚡ FULL BACKUP"
                            Command="{Binding FullBackupCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0 0 10 0"/>
                    <Button Content="⚡ DIFFERENTIAL"
                            Command="{Binding DifferentialBackupCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0 0 10 0"/>
                    <Button Content="⚡ INCREMENTAL"
                            Command="{Binding IncrementalBackupCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                </StackPanel>

            </StackPanel>
        </materialDesign:Card>

    </Grid>
</ScrollViewer>
</UserControl>
